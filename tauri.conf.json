{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clicky",
  "version": "0.1.0",
  "identifier": "dev.clicky.Clicky",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "panel",
        "title": "Clicky",
        "url": "panel.html",
        "width": 400,
        "height": 640,
        "resizable": false,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "icon": ["icons/icon.png"],
    "category": "Utility",
    "shortDescription": "Voice companion that sees your screen and points at things"
  }
}
